# =============================================
# DATABASE CONFIGURATION
# =============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=phone_store

# =============================================
# CRAWLER CONFIGURATION
# =============================================
# Maximum products to crawl (set to 0 for unlimited)
MAX_PRODUCTS=50

# Delay between requests (milliseconds)
MIN_DELAY=1500
MAX_DELAY=3500

# Number of retry attempts on failure
MAX_RETRIES=3

# Headless browser (true = no GUI, false = show browser)
HEADLESS=true

# =============================================
# OUTPUT CONFIGURATION
# =============================================
OUTPUT_DIR=./output
