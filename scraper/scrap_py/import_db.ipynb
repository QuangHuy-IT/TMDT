   "source": [
    "import json\n",
    "import os\n",
    "import random\n",
    "import re\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "def slugify(text):\n",
    "    \"\"\"Hàm tạo chuỗi slug an toàn cho DB từ tên sản phẩm\"\"\"\n",
    "    if not text:\n",
    "        return \"unknown\"\n",
    "    text = text.lower()\n",
    "    replacements = {\n",
    "        'à':'a','á':'a','ạ':'a','ả':'a','ã':'a','ă':'a','ằ':'a','ắ':'a','ẳ':'a','ẵ':'a','ặ':'a','â':'a','ầ':'a','ấ':'a','ẩ':'a','ẫ':'a','ậ':'a',\n",
    "        'è':'e','é':'e','ẻ':'e','ẽ':'e','ẹ':'e','ê':'e','ề':'e','ế':'e','ể':'e','ễ':'e','ệ':'e',\n",
    "        'ì':'i','í':'i','ỉ':'i','ĩ':'i','ị':'i',\n",
    "        'ò':'o','ó':'o','ỏ':'o','õ':'o','ọ':'o','ô':'o','ồ':'o','ố':'o','ổ':'o','ỗ':'o','ộ':'o','ơ':'o','ờ':'o','ớ':'o','ở':'o','ỡ':'o','ợ':'o',\n",
    "        'ù':'u','ú':'u','ủ':'u','ũ':'u','ụ':'u','ư':'u','ừ':'u','ứ':'u','ử':'u','ữ':'u','ự':'u',\n",
    "        'ỳ':'y','ý':'y','ỷ':'y','ỹ':'y','ỵ':'y','đ':'d'\n",
    "    }\n",
    "    for char, repl in replacements.items():\n",
    "        text = text.replace(char, repl)\n",
    "    text = re.sub(r'[^a-z0-9\\s-]', '', text)\n",
    "    text = re.sub(r'[\\s-]+', '-', text).strip('-')\n",
    "    return text\n",
    "\n",
    "def generate_random_date():\n",
    "    \"\"\"Sinh ngẫu nhiên datetime định dạng YYYY-MM-DD HH:MM:SS\"\"\"\n",
    "    start_date = datetime(2024, 1, 1)\n",
    "    end_date = datetime(2026, 6, 1) # Mốc thời gian hiện tại năm 2026\n",
    "    \n",
    "    time_between_dates = end_date - start_date\n",
    "    random_days = random.randrange(time_between_dates.days)\n",
    "    \n",
    "    random_date = start_date + timedelta(days=random_days)\n",
    "    return random_date.replace(\n",
    "        hour=random.randint(0, 23),\n",
    "        minute=random.randint(0, 59),\n",
    "        second=random.randint(0, 59)\n",
    "    ).strftime('%Y-%m-%d %H:%M:%S')\n",
    "\n",
    "def enrich_and_create_fields(input_file, output_file):\n",
    "    if not os.path.exists(input_file):\n",
    "        print(f\"❌ Lỗi: Không tìm thấy file nguồn '{input_file}'\")\n",
    "        return\n",
    "\n",
    "    with open(input_file, 'r', encoding='utf-8') as f:\n",
    "        products = json.load(f)\n",
    "\n",
    "    if isinstance(products, dict):\n",
    "        products = [products]\n",
    "\n",
    "    for item in products:\n",
    "        # Nếu không có product_info, tự tạo object rỗng để không bị crash lỗi gán phía sau\n",
    "        if \"product_info\" not in item or item[\"product_info\"] is None:\n",
    "            item[\"product_info\"] = {}\n",
    "            \n",
    "        product_info = item[\"product_info\"]\n",
    "        p_name = product_info.get(\"name\", \"Sản phẩm mới\")\n",
    "\n",
    "        # 1. TỰ TẠO trường 'slug' nằm ở ngoài (Ngang hàng bảng products)\n",
    "        if \"slug\" not in item or not item[\"slug\"]:\n",
    "            item[\"slug\"] = slugify(p_name)\n",
    "\n",
    "        # 2. TỰ TẠO trường 'created_at' nằm ở ngoài (Ngang hàng bảng products)\n",
    "        if \"created_at\" not in item or not item[\"created_at\"]:\n",
    "            item[\"created_at\"] = generate_random_date()\n",
    "\n",
    "        # 3. TỰ TẠO trường 'short_description' bên trong product_info\n",
    "        if \"short_description\" not in product_info or not product_info[\"short_description\"]:\n",
    "            product_info[\"short_description\"] = f\"Đánh giá nhanh {p_name}: Thiết kế thời thượng, cấu hình mạnh mẽ hàng đầu phân khúc, đáp ứng hoàn hảo mọi nhu cầu sử dụng.\"\n",
    "\n",
    "        # 4. TỰ TẠO trường 'sale' bên trong product_info\n",
    "        if \"sale\" not in product_info or product_info[\"sale\"] is None:\n",
    "            product_info[\"sale\"] = random.randint(5, 450)\n",
    "\n",
    "    # Ghi dữ liệu hoàn chỉnh ra file mới chuẩn bị đẩy vào Database\n",
    "    with open(output_file, 'w', encoding='utf-8') as f:\n",
    "        json.dump(products, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "    print(\"=========================================================\")\n",
    "    print(f\"✨ HỆ THỐNG TỰ ĐỘNG KHỞI TẠO VÀ ĐỔ DỮ LIỆU HOÀN TẤT!\")\n",
    "    print(f\"💾 Cấu trúc mới đã sẵn sàng tại: '{output_file}'\")\n",
    "    print(\"=========================================================\")\n",
    "\n",
    "# --- CHẠY THỰC THI ---\n",
    "enrich_and_create_fields('products_data_final_cleaned.json', 'products_data_final_cleaned.json')"
   ]
  },
