    "def move_fields_to_product_info(input_file, output_file):\n",
    "    if not os.path.exists(input_file):\n",
    "        print(f\"❌ Lỗi: Không tìm thấy file nguồn '{input_file}'\")\n",
    "        return\n",
    "\n",
    "    with open(input_file, 'r', encoding='utf-8') as f:\n",
    "        products = json.load(f)\n",
    "\n",
    "    # Đảm bảo dữ liệu dạng list để duyệt qua từng object\n",
    "    if isinstance(products, dict):\n",
    "        products = [products]\n",
    "\n",
    "    print(f\"⚡ Bắt đầu cấu trúc lại vị trí các trường cho {len(products)} sản phẩm...\")\n",
    "\n",
    "    for item in products:\n",
    "        # Kiểm tra an toàn xem dữ liệu product_info có tồn tại không\n",
    "        if \"product_info\" not in item or item[\"product_info\"] is None:\n",
    "            item[\"product_info\"] = {}\n",
    "            \n",
    "        product_info = item[\"product_info\"]\n",
    "\n",
    "        # 1. Chuyển trường 'slug' từ ngoài vào trong product_info\n",
    "        if \"slug\" in item:\n",
    "            product_info[\"slug\"] = item[\"slug\"]\n",
    "            del item[\"slug\"]  # Xóa bỏ trường slug ở lớp ngoài cùng\n",
    "\n",
    "        # 2. Chuyển trường 'created_at' từ ngoài vào trong product_info\n",
    "        if \"created_at\" in item:\n",
    "            product_info[\"created_at\"] = item[\"created_at\"]\n",
    "            del item[\"created_at\"]  # Xóa bỏ trường created_at ở lớp ngoài cùng\n",
    "\n",
    "    # Ghi lại dữ liệu sau khi đã dịch chuyển cấu trúc thành công\n",
    "    with open(output_file, 'w', encoding='utf-8') as f:\n",
    "        json.dump(products, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "    print(\"=========================================================\")\n",
    "    print(f\"✅ Hoàn thành cấu trúc lại dữ liệu!\")\n",
    "    print(f\"💾 File JSON mới lưu tại: '{output_file}'\")\n",
    "    print(\"=========================================================\")\n",
    "\n",
    "# --- CHẠY THỰC THI THAY ĐỔI ---\n",
    "# Đọc file vừa enrich xong và ghi đè hoặc xuất ra file chuẩn cuối cùng\n",
    "move_fields_to_product_info(\n",
    "    input_file='products_data_final_cleaned.json', \n",
    "    output_file='products_data_final_cleaned.json'  # Lưu đè để làm gọn file\n",
    ")"
   ]
