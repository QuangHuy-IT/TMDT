    "# %%\n",
    "import json\n",
    "import re\n",
    "\n",
    "\n",
    "def slugify(text):\n",
    "    text = str(text).lower()\n",
    "\n",
    "    vietnamese_map = {\n",
    "        'à':'a','á':'a','ạ':'a','ả':'a','ã':'a',\n",
    "        'â':'a','ầ':'a','ấ':'a','ậ':'a','ẩ':'a','ẫ':'a',\n",
    "        'ă':'a','ằ':'a','ắ':'a','ặ':'a','ẳ':'a','ẵ':'a',\n",
    "        'è':'e','é':'e','ẹ':'e','ẻ':'e','ẽ':'e',\n",
    "        'ê':'e','ề':'e','ế':'e','ệ':'e','ể':'e','ễ':'e',\n",
    "        'ì':'i','í':'i','ị':'i','ỉ':'i','ĩ':'i',\n",
    "        'ò':'o','ó':'o','ọ':'o','ỏ':'o','õ':'o',\n",
    "        'ô':'o','ồ':'o','ố':'o','ộ':'o','ổ':'o','ỗ':'o',\n",
    "        'ơ':'o','ờ':'o','ớ':'o','ợ':'o','ở':'o','ỡ':'o',\n",
    "        'ù':'u','ú':'u','ụ':'u','ủ':'u','ũ':'u',\n",
    "        'ư':'u','ừ':'u','ứ':'u','ự':'u','ử':'u','ữ':'u',\n",
    "        'ỳ':'y','ý':'y','ỷ':'y','ỹ':'y','ỵ':'y',\n",
    "        'đ':'d'\n",
    "    }\n",
    "\n",
    "    for old, new in vietnamese_map.items():\n",
    "        text = text.replace(old, new)\n",
    "\n",
    "    text = re.sub(r'[^a-z0-9]+', '-', text)\n",
    "    return text.strip('-')\n",
    "\n",
    "\n",
    "with open(INPUT_FILE, \"r\", encoding=\"utf-8\") as f:\n",
    "    products = json.load(f)\n",
    "\n",
    "variant_count = 0\n",
    "\n",
    "for product in products:\n",
    "\n",
    "    product_name = product[\"product_info\"][\"name\"]\n",
    "    product_slug = slugify(product_name)\n",
    "\n",
    "    for variant in product.get(\"variants\", []):\n",
    "\n",
    "        # -------------------------\n",
    "        # COST PRICE = 50% PRICE CŨ\n",
    "        # -------------------------\n",
    "        old_price = variant.get(\"price\")\n",
    "\n",
    "        if old_price is not None:\n",
    "            variant[\"cost_price\"] = int(old_price * 0.5)\n",
    "        else:\n",
    "            variant[\"cost_price\"] = None\n",
    "\n",
    "        # -------------------------\n",
    "        # PRICE = COMPARE_AT_PRICE\n",
    "        # -------------------------\n",
    "        compare_price = variant.get(\"compare_at_price\")\n",
    "\n",
    "        if compare_price is not None:\n",
    "            variant[\"price\"] = compare_price\n",
    "\n",
    "        # -------------------------\n",
    "        # XÓA COMPARE_AT_PRICE\n",
    "        # -------------------------\n",
    "        variant.pop(\"compare_at_price\", None)\n",
    "\n",
    "        # -------------------------\n",
    "        # SLUG\n",
    "        # -------------------------\n",
    "        color_slug = slugify(variant.get(\"color\", \"\"))\n",
    "\n",
    "        ram = variant.get(\"ram_gb\")\n",
    "        storage = variant.get(\"storage_gb\")\n",
    "\n",
    "        variant[\"slug\"] = (\n",
    "            f\"{product_slug}-\"\n",
    "            f\"{ram}gb-\"\n",
    "            f\"{storage}gb-\"\n",
    "            f\"{color_slug}\"\n",
    "        )\n",
    "\n",
    "        # -------------------------\n",
    "        # SKU\n",
    "        # -------------------------\n",
    "        brand = slugify(product.get(\"brand_name\", \"\"))\n",
    "        sku_color = color_slug.upper()\n",
    "\n",
    "        variant[\"sku\"] = (\n",
    "            f\"{brand.upper()}-\"\n",
    "            f\"{ram}GB-\"\n",
    "            f\"{storage}GB-\"\n",
    "            f\"{sku_color}\"\n",
    "        )\n",
    "\n",
    "        variant_count += 1\n",
    "\n",
    "with open(OUTPUT_FILE, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(products, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "print(f\"Đã cập nhật {variant_count} variants\")\n",
    "print(f\"Đã lưu file: {OUTPUT_FILE}\")"
   ]
  },
