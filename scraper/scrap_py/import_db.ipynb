    "        total_products_with_unexpected_null += 1\n",
    "\n",
    "        print(\"=\" * 120)\n",
    "        print(f\"Product #{idx}\")\n",
    "        print(f\"Name: {product['product_info']['name']}\")\n",
    "        print(f\"Slug: {product['product_info']['slug']}\")\n",
    "        print(f\"Số field null bất thường: {len(null_fields)}\")\n",
    "        print(\"-\" * 120)\n",
    "        \n",
    "        for field in null_fields:\n",
    "            print(field)\n",
    "\n",
    "        print()\n",
    "\n",
    "print(\"=\" * 120)\n",
    "print(\n",
    "    f\"Tổng số sản phẩm có null bất thường: \"\n",
    "    f\"{total_products_with_unexpected_null}/{len(products)}\"\n",
    ")"
