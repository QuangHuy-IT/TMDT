    "# %%\n",
    "import json\n",
    "\n",
    "FILE_NAME = \"products_data_final_cleaned.json\"\n",
    "\n",
    "with open(FILE_NAME, \"r\", encoding=\"utf-8\") as f:\n",
    "    products = json.load(f)\n",
    "\n",
    "# Các field được phép null\n",
    "IGNORE_NULL_FIELDS = {\n",
    "    \"variants.weight_gram\",\n",
    "    \"variants.barcode\",\n",
    "    \"variants.discount.discount_amount\",\n",
    "    \"variants.discount.start_at\",\n",
    "    \"variants.discount.end_at\",\n",
    "}\n",
    "\n",
    "\n",
    "def normalize_path(path):\n",
    "    \"\"\"\n",
    "    variants[0].weight_gram -> variants.weight_gram\n",
    "    variants[3].discount.end_at -> variants.discount.end_at\n",
    "    \"\"\"\n",
    "    import re\n",
    "    return re.sub(r\"\\[\\d+\\]\", \"\", path)\n",
    "\n",
    "\n",
    "def find_nulls(obj, path=\"\"):\n",
    "    results = []\n",
    "\n",
    "    if isinstance(obj, dict):\n",
    "        for key, value in obj.items():\n",
    "            current_path = f\"{path}.{key}\" if path else key\n",
    "\n",
    "            if value is None:\n",
    "                normalized = normalize_path(current_path)\n",
    "\n",
    "                if normalized not in IGNORE_NULL_FIELDS:\n",
    "                    results.append(current_path)\n",
    "            else:\n",
    "                results.extend(find_nulls(value, current_path))\n",
    "\n",
    "    elif isinstance(obj, list):\n",
    "        for i, item in enumerate(obj):\n",
    "            results.extend(find_nulls(item, f\"{path}[{i}]\"))\n",
    "\n",
    "    return results\n",
    "\n",
    "\n",
    "total_products_with_unexpected_null = 0\n",
    "\n",
    "for idx, product in enumerate(products, start=1):\n",
    "\n",
    "    null_fields = find_nulls(product)\n",
    "\n",
